# ParkGov AI public demo deployment variables
# Copy values into your shell session before running scripts/deploy/*.sh.
# Do not rename this file to .env and commit real secrets.

# GitHub personal access token with repo/workflow permission.
export GITHUB_TOKEN="ghp_replace_with_your_token"

# Netlify personal access token from:
# https://app.netlify.com/user/applications#personal-access-tokens
export NETLIFY_AUTH_TOKEN="nfp_replace_with_your_token"

# Render API key from:
# https://dashboard.render.com/u/*/settings#api-keys
export RENDER_API_KEY="rnd_replace_with_your_key"

# Neon PostgreSQL connection string. Prefer including sslmode=require.
export DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
export DATABASE_SSL="true"

# Fill these after Render creates the backend service.
export VITE_API_URL="https://parkgov-ai-backend.onrender.com/api"
export VITE_WS_URL="https://parkgov-ai-backend.onrender.com"

# Optional map configuration.
export VITE_ENABLE_REAL_MAP="true"
export VITE_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/positron"
