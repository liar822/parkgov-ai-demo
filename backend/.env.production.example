NODE_ENV=production
PORT=3000

# Neon / Supabase / Render PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true

# Comma-separated frontend origins allowed by CORS and Socket.IO.
FRONTEND_URLS=https://your-vercel-app.vercel.app

# Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-secret

# Optional AI runtime settings.
PYTHON_PATH=python3
AI_SERVICES_PYTHON=
