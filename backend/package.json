{
  "name": "ai-parking-backend",
  "version": "1.0.0",
  "description": "AI Autonomous Parking System Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:data-sources": "node scripts/seedDataSourcesFromRegistry.js",
    "import:osm-candidates": "node scripts/importOsmParkingCandidates.js",
    "import:parking-lots": "node scripts/importParkingLotsFromCsv.js",
    "import:beijing-open-data": "node scripts/importBeijingOpenData.js",
    "import:camera-sources": "node scripts/importCameraSourcesFromCsv.js",
    "import:slot-rois": "node scripts/importSlotRoisFromCsv.js",
    "backfill:ai-jobs": "node scripts/backfillAiProcessingJobs.js",
    "demo:ai-run": "node scripts/runDemoAiInference.js",
    "demo:ai-infer": "node scripts/runDemoAiModelInference.js",
    "demo:ai-infer:cnr": "node scripts/runDemoAiModelInference.js --config ../../data/demo_ai_inference_config_cnrpark.json",
    "demo:ai-infer:campus-synthetic": "node scripts/runDemoAiModelInference.js --config ../../data/demo_ai_inference_config_campus_synthetic.json",
    "demo:reset": "node scripts/resetDemoData.js",
    "dataset:registry": "node scripts/printVisionDatasetRegistry.js",
    "dataset:download": "node scripts/downloadVisionDataset.js",
    "train:slot-classifier": "node scripts/runSlotClassifierTraining.js",
    "evaluate:slot-classifier": "node scripts/evaluateSlotClassifier.js",
    "seed:mvp": "node scripts/seedMvpDemoData.js",
    "check:db-init": "node scripts/checkDatabaseInitSql.js",
    "check:api": "node scripts/checkApiSmoke.js",
    "check:all": "node scripts/checkAll.js",
    "test": "jest"
  },
  "keywords": ["parking", "ai", "computer-vision", "nodejs"],
  "author": "AI Parking System",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.2",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "python-shell": "^5.0.0",
    "uuid": "^9.0.0",
    "joi": "^17.9.2",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "supertest": "^6.3.3"
  }
}
